{
  "_readme": [
    "Claude Code MCP config - place at project root as .mcp.json",
    "Run: ./setup-mcp.sh claude (auto-replaces $PROJECT_DIR and credentials from .env)",
    "Or copy this file to .mcp.json and replace placeholders manually"
  ],
  "mcpServers": {
    "airflow-dev": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "$PROJECT_DIR",
        "mcp-server-apache-airflow"
      ],
      "env": {
        "AIRFLOW_HOST": "https://pidgey.ready-internal.net",
        "AIRFLOW_USERNAME": "$AIRFLOW_USERNAME",
        "AIRFLOW_PASSWORD": "$AIRFLOW_PASSWORD",
        "AIRFLOW_VERIFY": "false",
        "READ_ONLY": "true"
      }
    }
  }
}
