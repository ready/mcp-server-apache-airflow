{
  "_readme": [
    "VSCode GitHub Copilot MCP config - place at .vscode/mcp.json",
    "Run: ./setup-mcp.sh vscode (auto-replaces $PROJECT_DIR and credentials from .env)",
    "Or copy this file to .vscode/mcp.json and replace placeholders manually",
    "Note: Uses 'servers' key (not 'mcpServers') for VSCode Copilot format"
  ],
  "servers": {
    "airflow-dev": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "$PROJECT_DIR",
        "mcp-server-apache-airflow"
      ],
      "env": {
        "AIRFLOW_HOST": "https://pidgey.ready-internal.net",
        "AIRFLOW_USERNAME": "$AIRFLOW_USERNAME",
        "AIRFLOW_PASSWORD": "$AIRFLOW_PASSWORD",
        "AIRFLOW_VERIFY": "false",
        "READ_ONLY": "true"
      }
    }
  }
}
